{
  "name": "xiaoying-resume",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "托管在 Cloudflare 的在线简历站点，视频存于 R2 并通过 Worker 签名防盗链播放",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "bucket:create": "wrangler r2 bucket create xiaoying-video",
    "secret:sign": "wrangler secret put SIGN_SECRET",
    "secret:token": "wrangler secret put SIGN_TOKEN"
  },
  "devDependencies": {
    "hls.js": "^1.7.3",
    "wrangler": "^4.0.0"
  }
}
