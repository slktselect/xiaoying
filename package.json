{
  "name": "xiaoying-resume",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "托管在 Cloudflare 的在线简历站点：React + Tailwind 前端，视频存于 R2 并通过 Worker 签名防盗链播放",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "bucket:create": "wrangler r2 bucket create xiaoying-video",
    "secret:sign": "wrangler secret put SIGN_SECRET",
    "secret:token": "wrangler secret put SIGN_TOKEN"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wrangler": "^4.0.0"
  }
}
